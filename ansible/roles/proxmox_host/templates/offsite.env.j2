# {{ ansible_managed }}
# Sourced by offsite-backup.sh. Root-only, 0600.
#
# ⚠️ RESTIC_PASSWORD is root-of-trust material, same tier as the OpenBao unseal
# keys: without it the offsite repository is an unreadable blob. Its durable
# copy belongs in the password manager, NOT in the backup it protects, and NOT
# only here: this file lives on the very node a fire would take.
export RESTIC_REPOSITORY="{{ proxmox_host_offsite_repository }}"
export RESTIC_PASSWORD="{{ proxmox_host_offsite_vault.restic_password }}"
export AWS_ACCESS_KEY_ID="{{ proxmox_host_offsite_vault.r2_access_key_id }}"
export AWS_SECRET_ACCESS_KEY="{{ proxmox_host_offsite_vault.r2_secret_access_key }}"
# R2 has one region and calls it "auto"; the S3 client still insists on being told.
export AWS_DEFAULT_REGION="auto"

# Note on what Cloudflare never sees: restic encrypts client-side, on the node,
# before a byte leaves. The object store holds opaque packs, so the data
# residency question is much weaker here than it would be for plaintext, which
# is why a location hint is enough and the EU jurisdiction is optional.
