# {{ ansible_managed }}
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
PG_PASS={{ authentik_postgres_password }}
# Consumed by the freshrss-oidc blueprint through its `!Env` tag, so the
# blueprint file itself carries no secret: it is mounted readable into the
# containers; this file is not.
AUTHENTIK_FRESHRSS_CLIENT_SECRET={{ authentik_freshrss_client_secret }}
# Same, for the linkding-oidc blueprint.
AUTHENTIK_LINKDING_CLIENT_SECRET={{ authentik_linkding_client_secret }}
