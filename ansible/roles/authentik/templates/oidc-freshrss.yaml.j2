# {{ ansible_managed }}
# FreshRSS authenticates its web interface against Authentik directly, rather
# than through the forward-auth middleware the admin apps use. The reason is in
# upstream's Apache config: `AuthType openid-connect` is applied to the `p/i/`
# directory only, and `p/api/` sits outside it, so the Google Reader API keeps
# answering on its own API password and mobile readers still work. Forward-auth
# would have stopped them at the login redirect, the same wall Jellyfin and
# Home Assistant hit.
#
# No secret in this file: it is mounted world-readable into the containers, so
# the client secret comes from the worker's environment instead (`.env`, 0600).
version: 1
metadata:
  name: freshrss-oidc
  labels:
    blueprints.goauthentik.io/instantiate: "true"

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: freshrss-oidc
    identifiers:
      name: freshrss
    attrs:
      client_type: confidential
      client_id: "{{ authentik_freshrss_client_id }}"
      client_secret: !Env AUTHENTIK_FRESHRSS_CLIENT_SECRET
      # Not optional, and not obvious. The model default is an empty list, which
      # means *no* grant is allowed: the provider comes up looking correct, the
      # discovery document serves, and the first sign-in dies on
      # `invalid_request` / "The request is otherwise malformed" while the server
      # log says `Invalid grant_type for provider`. The UI wizard fills this in;
      # a blueprint has to say it.
      # `refresh_token` alongside so a session can be renewed without a full
      # round trip through the browser.
      grant_types:
        - authorization_code
        - refresh_token
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      # RS256 via the JWKS endpoint. Without a signing key Authentik falls back
      # to HS256 with the client secret, which mod_auth_openidc accepts but
      # which puts the signing material on both sides of the exchange.
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      # mod_auth_openidc's callback, fixed by upstream's Apache config
      # (`OIDCRedirectURI /i/oidc/`). Strict matching: a redirect URI is where
      # the authorization code is delivered, so it should not be a pattern.
      #
      # Both forms are registered, and that is not belt-and-braces. With
      # `OIDCXForwardedHeaders` set, mod_auth_openidc rebuilds the callback from
      # X-Forwarded-Host and can emit the explicit `:443`. FreshRSS's own
      # Authentik guide says the port is required or Authentik answers
      # `redirect_url` error. Which of the two it sends depends on the headers
      # Traefik happens to pass, so accept exactly these two and nothing else.
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ freshrss_host }}/i/oidc/"
        - matching_mode: strict
          url: "https://{{ freshrss_host }}:443/i/oidc/"
      # `profile` carries preferred_username, which is what FreshRSS matches
      # against its own user list: the Authentik username and the FreshRSS one
      # have to be the same string.
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]

  # The slug is not cosmetic: it is what builds the discovery URL the reader
  # fetches, https://auth.<domain>/application/o/<slug>/.well-known/openid-configuration.
  - model: authentik_core.application
    identifiers:
      slug: "{{ authentik_freshrss_client_id }}"
    attrs:
      name: FreshRSS
      provider: !KeyOf freshrss-oidc
