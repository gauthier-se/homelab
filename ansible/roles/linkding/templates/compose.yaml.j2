# {{ ansible_managed }}
#
# Secrets are not in this file. Docker Compose interpolates `${...}` from the
# `.env` file beside it (mode 0600), so the compose file stays readable and
# diffable while the credentials do not.
#
# One service, no database container: Linkding stores everything in a SQLite
# file under data/, which is the reason this guest is 8 GB and 1 GB of RAM
# rather than FreshRSS's 12 and 1.5.
services:
  linkding:
    image: {{ linkding_image }}
    container_name: linkding
    restart: unless-stopped
    ports:
      - "{{ linkding_port }}:9090"
    volumes:
      # Holds db.sqlite3 and its WAL, plus favicons/, previews/ and assets/.
      # The whole of it is the backup surface; nothing else on this guest is.
      - ./data:/etc/linkding/data
    environment:
      TZ: "{{ homelab_timezone }}"
      # Django checks the Origin header against the scheme it thinks it is
      # serving, which behind a TLS-terminating proxy is http. Without this
      # every POST answers "CSRF verification failed", including the sign-in,
      # so the symptom is a login that cannot be completed rather than an
      # obviously broken app.
      LD_CSRF_TRUSTED_ORIGINS: "{{ linkding_csrf_trusted_origins }}"
      # Created on first start only: `create_initial_superuser` returns early if
      # the username already exists, so this is not a place to rotate anything.
      # The task after this stack starts is what keeps the account correct.
      LD_SUPERUSER_NAME: "${SUPERUSER_NAME}"
      # LD_SUPERUSER_PASSWORD is deliberately absent, not empty-by-accident.
      # Unset means `set_unusable_password()`: the account exists and no
      # password will ever authenticate it, so the only way in is Authentik and
      # there is no second credential to rotate, leak or forget.
{% if linkding_disable_login_form %}
      LD_DISABLE_LOGIN_FORM: "True"
{% endif %}
{% if linkding_oidc_enabled %}
      # SSO on the web interface. This is Django middleware, not a rule on a
      # URL prefix as in FreshRSS's Apache: the REST API under /api/ answers on
      # an `Authorization: Token` header that never reaches the session layer,
      # so the browser extension and any script keep working regardless.
      LD_ENABLE_OIDC: "True"
      OIDC_OP_AUTHORIZATION_ENDPOINT: "{{ linkding_oidc_authorization_endpoint }}"
      OIDC_OP_TOKEN_ENDPOINT: "{{ linkding_oidc_token_endpoint }}"
      OIDC_OP_USER_ENDPOINT: "{{ linkding_oidc_user_endpoint }}"
      OIDC_OP_JWKS_ENDPOINT: "{{ linkding_oidc_jwks_endpoint }}"
      OIDC_RP_CLIENT_ID: "{{ linkding_oidc_client_id }}"
      OIDC_RP_CLIENT_SECRET: "${OIDC_CLIENT_SECRET}"
      OIDC_RP_SCOPES: "{{ linkding_oidc_scopes }}"
      # Only decides how a newly created account is *named*. Which account an
      # incoming identity resolves to is decided by the email claim, upstream in
      # mozilla-django-oidc, and nothing here can change that.
      OIDC_USERNAME_CLAIM: "{{ linkding_oidc_username_claim }}"
{% endif %}
    # No healthcheck block: the image ships one (`curl -f localhost:9090/health`,
    # 30s interval), and restating it here would only create a second thing to
    # keep in step with upstream.
