# {{ ansible_managed }}
#
# OpenBao's `homelab/{{ dashboard_vault_path }}` becomes HOMEPAGE_VAR_* here;
# the config files reference these by name. That split is the point: this file
# is 0600, services.yaml is world-readable.
#
# Values are double-quoted so Compose's dotenv parser does not treat a `#` as a
# comment. ⚠️ Compose's `env_file:` strips those quotes, `docker run --env-file`
# does not, debugging by hand with the latter yields `username: ""value""`,
# which Homepage reports as a YAML indentation error. Use `docker compose` here.
{% for key, value in (dashboard_secrets | dictsort) %}
HOMEPAGE_VAR_{{ key | upper }}="{{ value }}"
{% endfor %}
