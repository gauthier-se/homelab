---
# Aligned with ansible-lint's expectations (relaxed line length, inline maps).
extends: default

rules:
  line-length:
    max: 160
    level: warning
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  truthy:
    check-keys: false

ignore: |
  opentofu/.terraform/
  ansible/collections/
