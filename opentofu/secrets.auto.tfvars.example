# Copy to secrets.auto.tfvars (untracked, see .gitignore) and fill in.
# Real values live under $HOMELAB_SECRETS, then in OpenBao.

proxmox_endpoint = "https://10.10.10.3:8006/"

# Bootstrap auth (see providers.tf): root@pam password, API tokens cannot set
# LXC feature flags / device passthrough.
proxmox_password = "CHANGE_ME"

# Kept for later, once root-only attributes are gone from the catalogue.
# proxmox_api_token = "terraform@pve!provisioner=00000000-0000-0000-0000-000000000000"

# SSH public key installed for root in every container (Ansible then connects
# over SSH). Use the Ansible control key, not a personal one.
lxc_public_key = "ssh-ed25519 AAAA... ansible@homelab"

# SSH public key authorized on the VMs' *seed* image, so that nixos-anywhere can
# log in as root and install over it. Your workstation key, not the Ansible one:
# nothing automated ever uses it, and the installed system authorizes its own
# keys from the NixOS config.
vm_public_key = "ssh-ed25519 AAAA... you@workstation"
